{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "commands": ["npm ci"]
    },
    "build": {
      "inputs": [{ "step": "install" }],
      "commands": [
        "npm run build -w @hospitalityos/shared",
        "npm run build:self -w sovereign-drive-engine"
      ]
    }
  },
  "deploy": {
    "startCommand": "npm run start -w sovereign-drive-engine"
  }
}
