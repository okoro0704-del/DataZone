{
  "name": "@datazone/service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "prebuild": "npm run build -w @hospitalityos/shared && npm run build -w @datazone/db",
    "build": "npm run build -w @hospitalityos/shared && npm run build -w @datazone/db && tsc -p tsconfig.json",
    "build:self": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@datazone/db": "*",
    "@hospitalityos/shared": "*",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jose": "^5.9.6",
    "multer": "^1.4.5-lts.1",
    "typescript": "^5.7.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "vitest": "^3.0.4"
  }
}
